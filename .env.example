# このファイルを .env.local にコピーして、自分のAPIキーを設定してください。
# .env.local は .gitignore 済みです。絶対にコミットしないでください。
#
#   cp .env.example .env.local
#
# ----------------------------------------------------------------------------
# 設定するのは基本的に3つだけです。
#
#   LLM_BASE_URL  接続先（未設定なら OpenAI）
#   LLM_MODEL     使うモデル（必須。既定値はありません）
#   LLM_API_KEY   そのサービスのAPIキー
#
# OpenAI互換のエンドポイントであれば、この3つを差し替えるだけで動きます。
# リクエストの中身は変わりません。
# ----------------------------------------------------------------------------

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# ============================================================================
# 接続先ごとの設定例（使うものだけコメントを外してください）
# ============================================================================

# --- OpenAI ---------------------------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Google Gemini --------------------------------------------------------
# 公式のOpenAI互換エンドポイント。画像入力も同じ形式で通ります。
# APIキーは https://aistudio.google.com/apikey で取得します。
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.6-flash

# --- OpenRouter -----------------------------------------------------------
# キー1本で多数のモデルを試せます。モデル比較をしたいときに便利です。
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3-vl-8b-instruct

# --- NVIDIA NIM -----------------------------------------------------------
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=qwen/qwen3-vl-8b-instruct

# --- Ollama（ローカル） -----------------------------------------------------
# 完全に無料・無制限です。8Bクラスのvisionモデルで約6GBのVRAMが必要です。
# APIキーは使われないので、任意の文字列で構いません。
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3-vl:8b
# LLM_API_KEY=ollama

# --- Ollama Cloud ---------------------------------------------------------
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=qwen3-vl:8b

# --- Anthropic（Claude） ----------------------------------------------------
# ここだけAPI形式が異なるため、LLM_PROVIDER の指定が必要です。
# LLM_BASE_URL は使われません。
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5

# ============================================================================
# 任意の設定
# ============================================================================

# 接続先の種類。既定は openai-compatible です。
# Anthropic を使うときだけ anthropic を指定してください。
# LLM_PROVIDER=openai-compatible

# AIサービスの応答を待つ時間（ミリ秒）。既定は 30000（30秒）です。
# 指定できる範囲は 1000〜180000 です。
# 推論（thinking）が有効なモデルを使うと30秒では足りない場合があります。
# LLM_TIMEOUT_MS=30000

# ============================================================================
# 後方互換
# ============================================================================
# LLM_API_KEY が未設定の場合、以下も参照されます。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
